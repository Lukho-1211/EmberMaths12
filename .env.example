# Postgres connection string (Neon, Vercel Postgres, local Docker, or `npx prisma dev`)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ember12?schema=public"

# Auth.js secret — generate with: npx auth secret
# Or: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: canonical URL (useful behind proxies / production)
# AUTH_URL="http://localhost:3000"
# AUTH_TRUST_HOST="true"
